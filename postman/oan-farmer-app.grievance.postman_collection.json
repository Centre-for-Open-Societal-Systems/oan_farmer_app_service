        {
          "name": "Submit a grievance",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idem_key\", \"run-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is one of [200, 201]\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"answers in the mobile envelope\", () => {",
                  "  pm.expect(body).to.be.an(\"object\");",
                  "  pm.expect(body.status).to.be.oneOf([\"success\", \"error\"]);",
                  "});",
                  "if (body.status === \"error\") {",
                  "  pm.test(\"error carries a code and a message\", () => {",
                  "    pm.expect(body.code).to.be.a(\"string\");",
                  "    pm.expect(body.message).to.be.a(\"string\");",
                  "  });",
                  "  pm.test(\"error does not leak a traceback or a backend URL\", () => {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include(\"Traceback\");",
                  "    pm.expect(text).to.not.match(/https?:\\/\\/(?:127\\.0\\.0\\.1|localhost)/);",
                  "  });",
                  "}",
                  "const d = pm.response.json().data || {};",
                  "const ticket = d.ticket_number || d.name || d.ticket;",
                  "pm.test(\"returns a ticket\", () => pm.expect(ticket, JSON.stringify(d)).to.be.ok);",
                  "if (ticket) pm.collectionVariables.set(\"ticket\", ticket);",
                  "pm.collectionVariables.set(\"first_ticket\", ticket || \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
