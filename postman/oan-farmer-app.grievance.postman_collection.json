      "item": [
        {
          "name": "Without a token is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is one of [401]\", () => pm.expect(pm.response.code).to.be.oneOf([401]));",
                  "pm.test(\"refused as an authentication error\", () => pm.expect(pm.response.json().exc_type).to.eql(\"AuthenticationError\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-App-Version",
                "value": "{{app_version}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/grievance/{{grievance_version}}/submitters/options",
              "host": [
                "{{base_url}}"
              ],
              "path": [
